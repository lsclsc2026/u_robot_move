<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>u_robot_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 localization, planning, control, collision monitoring, and waypoint configuration for A2.</description>
  <maintainer email="devnull@example.com">u_robot_move maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>u_robot_bringup</exec_depend>
  <exec_depend>u_robot_camera_bridge</exec_depend>
  <exec_depend>u_robot_localization</exec_depend>
  <exec_depend>u_robot_observability</exec_depend>
  <exec_depend>u_robot_perception</exec_depend>
  <exec_depend>u_robot_patrol</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
