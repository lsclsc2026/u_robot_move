<?xml version="1.0"?>
<package format="3">
  <name>u_robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch and deployment configuration for the A2 navigation stack.</description>
  <maintainer email="devnull@example.com">u_robot_move maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>u_robot_a2_driver</exec_depend>
  <exec_depend>u_robot_description</exec_depend>
  <exec_depend>u_robot_camera_bridge</exec_depend>
  <exec_depend>u_robot_observability</exec_depend>
  <exec_depend>u_robot_state_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
